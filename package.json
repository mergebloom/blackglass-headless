{
	"name": "blackglass-headless",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"description": "Headless command-line client for Blackglass Sync",
	"main": "blackglass-headless.cjs",
	"bin": {
		"blackglass-headless": "blackglass-headless.cjs",
		"bgh": "blackglass-headless.cjs"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"files": [
		"blackglass-headless.cjs",
		"lib",
		"cli.js",
		"btime",
		"package.json",
		"README.md",
		"THIRD_PARTY_NOTICES.md",
		"UPSTREAM.md",
		"UPSTREAM.json"
	],
	"scripts": {
		"test": "node --test tests/*.test.cjs",
		"test:e2e": "node --test tests/blackglass-server.e2e.cjs",
		"check": "npm test && node tools/check-upstream.cjs"
	},
	"keywords": [
		"obsidian",
		"sync",
		"vault",
		"markdown",
		"notes"
	],
	"homepage": "https://github.com/mergebloom/blackglass-headless",
	"repository": {
		"type": "git",
		"url": "https://github.com/mergebloom/blackglass-headless"
	},
	"author": "Blackglass contributors; upstream client by Dynalist Inc.",
	"license": "UNLICENSED",
	"dependencies": {
		"better-sqlite3": "12.11.1",
		"commander": "14.0.3",
		"ws": "8.21.3"
	}
}
